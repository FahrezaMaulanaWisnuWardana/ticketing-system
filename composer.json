{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "internal/ticketing-system",
    "type": "project",
    "description": "Internal helpdesk, dev work tracking and project management",
    "keywords": ["laravel", "ticketing", "helpdesk"],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ezyang/htmlpurifier": "^4.19",
        "laravel/framework": "^13.43",
        "laravel/horizon": "^5.52",
        "laravel/reverb": "^1.14",
        "laravel/sanctum": "^4.5",
        "laravel/socialite": "^5.33",
        "laravel/tinker": "^3.2",
        "league/commonmark": "^2.10",
        "livewire/livewire": "^3.8"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.8",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.15",
        "laravel/boost": "*",
        "laravel/pint": "^1.18",
        "laravel/telescope": "^5.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "check": [
            "@test",
            "@lint",
            "@analyse"
        ],
        "test": "php artisan test",
        "lint": "pint --test",
        "analyse": "phpstan analyse --no-progress"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
