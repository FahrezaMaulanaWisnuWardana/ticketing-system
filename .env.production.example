APP_NAME=Ticketing
APP_ENV=production
APP_DEBUG=false
APP_URL=https://ticketing.example.com
APP_KEY=base64:REPLACE_WITH_A_REAL_KEY
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC
DISPLAY_TIMEZONE=Asia/Jakarta

# Must match secrets/db_password.txt used by Postgres in docker-compose.prod.yml
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ticketing
DB_USERNAME=postgres
DB_PASSWORD=replace-me

SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PASSWORD=replace-me

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=app-id
REVERB_APP_KEY=replace-me
REVERB_APP_SECRET=replace-me
REVERB_HOST=ticketing.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SCALING_ENABLED=true

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me
MAIL_FROM_ADDRESS=no-reply@example.com

INTEGRATION_TRELLO_ENABLED=false
CSP_MODE=enforce
